# ── dev: deployed to mainnet by scripts/deploy.sh dev ──
# Only PUBLIC values live in this file (and in the repo as a whole).
#
# UPGRADE_AUTHORITY — the wallet that controls this env's program: it pays
# for and signs every deploy/upgrade/close. Pubkey chosen by you; the private
# key stays in your wallet app (Phantom) and is pasted at the deploy prompt —
# never stored. If you later move the authority on-chain
# (solana program set-upgrade-authority), update this line to match.
UPGRADE_AUTHORITY=5gjUjStnVgooDXiJ8v5vtzXLCiXPyCJe8CqzQCay5zMq

# PULLER_KEYS — pubkeys allowed to trigger `pull`. Stored in the program's
# ON-CHAIN Config account, not in the code: deploy.sh syncs this list after
# deploying, and scripts/set-puller-keys.sh applies changes with a single
# data transaction — no rebuild, no redeploy, audited code untouched.
# The private keys live in this env's backend Key Vault / secrets. Multiple
# space-separated keys are allowed (zero-downtime rotation); an EMPTY string
# is the kill switch — no key can pull until the list is restored.
PULLER_KEYS="AbCynfpDceVNnm7geWraEgZLD52PKraxNYE7KAuvqJ96 D8BXX8NxgxFN9LifSuDYQ8rTBfd9wfzVAL1KrntMBnU1"

# PROGRAM_ID — the smart contract's on-chain address; appears here after the
# first deploy (the pubkey of a random keypair scripts/deploy.sh mints and
# discards). Both backend settings — SolanaSubscriptionConfig--SmartContractAddress
# (Core API app) and SolanaSubscriptionPullerConfig--SmartContractAddress
# (Backend Functions app) — are set to this same value; the backend then
# derives the MeshDelegate PDA (each subscription's on-chain 'delegatee')
# from it by itself, so the PDA is never a config value. close.sh removes
# the pinned id (a closed id is burned; the next deploy mints afresh).
PROGRAM_ID=GK9iWuuYxmhEZivsKSkXUmQuryQd4jKJWVsdDHCo9QjW
# ^ the smart contract address. Set BOTH backend settings to it (same value):
#   SolanaSubscriptionConfig--SmartContractAddress        (Core API app)
#   SolanaSubscriptionPullerConfig--SmartContractAddress  (Backend Functions app)
# The backend derives the MeshDelegate PDA from it by itself — not a config
# value. Informational, for cross-checking the backend's derivation; this PDA
# becomes the 'delegatee' recorded on each subscription (DB row + on-chain):
# MeshDelegate PDA = C24NG2VkS3nbS5qMQ226Cd4H4SQQ1DoGoynuXQVg97q1
